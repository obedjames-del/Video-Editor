# API Keys - Get your keys from the respective services
# ==============================================================================

# ElevenLabs API Key
# Get from: https://elevenlabs.io/app/settings/api-keys
# Pricing: Free tier (10k chars/month), Starter $5/mo (30k chars/month)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Pexels API Key
# Get from: https://www.pexels.com/api/
# Pricing: Free (200 requests/hour)
PEXELS_API_KEY=your_pexels_api_key_here

# Google Gemini API Key
# Get from: https://ai.google.dev/
# Pricing: Free tier available, paid ~$0.35 per 1M tokens
GEMINI_API_KEY=your_gemini_api_key_here


# Default Settings
# ==============================================================================

# Default ElevenLabs Voice ID
# Find voice IDs in ElevenLabs dashboard voice library
# Example: "21m00Tcm4TlvDq8ikWAM" (Rachel - default female voice)
DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Default video resolution (widthxheight)
DEFAULT_RESOLUTION=1920x1080

# Default frames per second
DEFAULT_FPS=30

# Default video orientation: landscape, portrait, or square
DEFAULT_ORIENTATION=landscape


# Processing Options
# ==============================================================================

# Enable caching of downloaded videos and audio
ENABLE_CACHE=true

# Directory to store cached assets
CACHE_DIR=./cache

# Directory to store generated videos
OUTPUT_DIR=./output

# Maximum number of parallel video downloads
MAX_PARALLEL_DOWNLOADS=5


# Gemini Settings
# ==============================================================================

# Use Gemini for automatic video keyword generation by default
USE_GEMINI_BY_DEFAULT=false

# Gemini model to use
# Options: gemini-2.0-flash (fastest), gemini-2.0-pro (more intelligent)
GEMINI_MODEL=gemini-2.0-flash


# Advanced Settings (Optional)
# ==============================================================================

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# FFmpeg logging level: quiet, panic, fatal, error, warning, info, verbose, debug
FFMPEG_LOG_LEVEL=error

# Temporary directory for intermediate files
TEMP_DIR=./temp

# Maximum video file size in MB (per clip)
MAX_VIDEO_SIZE_MB=100

# Connection timeout for API requests (seconds)
API_TIMEOUT=30

# Number of retries for failed API requests
API_MAX_RETRIES=3
